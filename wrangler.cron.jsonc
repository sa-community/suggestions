{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sa-suggestions-cron",
	"compatibility_date": "2025-06-16",
	"main": "cron-worker.ts",
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	},
	"vars": {
		"SITE_URL": "https://suggestions.pages.dev"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}